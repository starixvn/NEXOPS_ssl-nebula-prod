[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
[req_distinguished_name]
countryName = VN
countryName_default = VN
stateOrProvinceName = HCM
stateOrProvinceName_default = HN
localityName = HCM
localityName_default = HCM
organizationalUnitName = NexOps
organizationalUnitName_default = NexOps
commonName = *.nebula.prod
commonName_max = 64
[ v3_req ]
# Extensions to add to a certificate request
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName = @alt_names
[alt_names]
DNS.1 = *.nebula.prod
DNS.2 = *.st-dr.nebula.prod
DNS.3 = *.ops-dr.nebula.prod
DNS.4 = *.st-alpdr.nebula.prod
DNS.5 = *.sc-dr.nebula.prod

